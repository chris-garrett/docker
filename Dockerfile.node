FROM debian:trixie-slim AS build

ARG TARGETARCH

ENV PUID=1000 PGID=1000
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/work/opt/bin:$PATH"
ENV HOST_ENVIRONMENT=container

RUN --mount=target=/var/lib/apt/lists,type=cache,sharing=locked,mode=0755 \
    --mount=target=/var/cache/apt,type=cache,sharing=locked,mode=0755 \
    set -eux; \
    apt update; \
    apt upgrade -y; \
    apt install -y --no-install-recommends \
    gosu \
    ca-certificates \
    libicu76 \
    tzdata \
    xz-utils \
    vim \
    git \
    git-lfs \
    build-essential \
    iputils-ping \
    iproute2 \
    procps \
    binutils \
    ncdu \  
    unzip \
    curl \
    file \
    ; \
    echo "alias l='ls -laFHh'" >> /root/.bashrc; \
    echo "export PATH=\"/work/opt/bin:\$PATH\"" >> /root/.bashrc; \
    mkdir -p /work/app /work/opt/bin; \
    rm -rf /var/lib/apt/lists/*;

# install watchexec
RUN set -eux; \
    if [ "$TARGETARCH" = "arm64" ]; then \
    ARCH="aarch64"; \
    else \
    ARCH="x86_64"; \
    fi; \
    curl -o /tmp/watchexec.tar.xz -LsSf --retry 5 --retry-all-errors --retry-delay 2 https://github.com/watchexec/watchexec/releases/download/v2.8.0/watchexec-2.8.0-${ARCH}-unknown-linux-gnu.tar.xz; \
    tar -C /work/opt/bin --strip-components=1 -xf /tmp/watchexec.tar.xz watchexec-2.8.0-${ARCH}-unknown-linux-gnu/watchexec

# install dockerize
RUN set -eux; \
    curl -o /tmp/dockerize.tgz -LsSf https://github.com/jwilder/dockerize/releases/download/v0.16.0/dockerize-linux-${TARGETARCH}-v0.16.0.tar.gz; \
    tar -C /work/opt/bin -xf /tmp/dockerize.tgz 

# add static curl
RUN set -eux; \
    if [ "$TARGETARCH" = "arm64" ]; then \
    ARCH="aarch64"; \
    else\
    ARCH="x86_64"; \
    fi; \
    curl -o /tmp/curl.tgz -L -C - https://github.com/stunnel/static-curl/releases/download/8.23.0-1/curl-linux-${ARCH}-glibc-8.23.0-1.tar.xz; \
    tar -C /work/opt/bin -xf /tmp/curl.tgz

# install github actions runner (extracted to /work/opt/actions-runner; run ./config.sh & ./run.sh from there)
RUN --mount=target=/var/lib/apt/lists,type=cache,sharing=locked,mode=0755 \
    --mount=target=/var/cache/apt,type=cache,sharing=locked,mode=0755 \
    set -eux; \
    if [ "$TARGETARCH" = "arm64" ]; then \
    RUNNER_ARCH="arm64"; \
    else \
    RUNNER_ARCH="x64"; \
    fi; \
    mkdir -p /work/opt/actions-runner; \
    curl -o /tmp/actions-runner.tar.gz -LsSf https://github.com/actions/runner/releases/download/v2.338.2/actions-runner-linux-${RUNNER_ARCH}-2.338.2.tar.gz; \
    tar -C /work/opt/actions-runner -xzf /tmp/actions-runner.tar.gz; \
    rm /tmp/actions-runner.tar.gz; \
    /work/opt/actions-runner/bin/installdependencies.sh; \
    rm -rf /var/lib/apt/lists/*

# install Gitea runner (upstream renamed act_runner; keep the existing command)
RUN set -eux; \
    curl -o /work/opt/bin/act_runner -LsSf https://gitea.com/gitea/runner/releases/download/v5.4.1/gitea-runner-5.4.1-linux-${TARGETARCH}; \
    chmod +x /work/opt/bin/act_runner

ENV NODE_ENV=development
ENV FNM_DIR=/work/opt/fnm
ENV FNM_COREPACK_ENABLED=false

RUN --mount=target=/root/.cache/node,type=cache,sharing=locked,mode=0755 \
    set -eux; \
    if [ "$TARGETARCH" = "arm64" ]; then \
    ARCH="arm64"; \
    else \
    ARCH="linux"; \
    fi; \
    curl -o /tmp/fnm.zip -LsSf "https://github.com/Schniz/fnm/releases/download/v1.39.0/fnm-${ARCH}.zip"; \
    unzip -d /work/opt/bin /tmp/fnm.zip;

RUN cat <<EOF >> /tmp/fnm-init.sh
#!/bin/bash
eval "$(/work/opt/bin/fnm env --use-on-cd --shell bash)"
/work/opt/bin/fnm use 26.13.0 --install-if-missing;
npm install --global corepack@0.36.0;
corepack enable;
EOF

# install node
RUN set -eux; \
    bash /tmp/fnm-init.sh;

# install bun
RUN set -eux; \
    if [ "$TARGETARCH" = "arm64" ]; then \
    ARCHIVE="bun-linux-aarch64"; \
    else \
    ARCHIVE="bun-linux-x64"; \
    fi; \
    curl -o /tmp/bun.zip -LsSf "https://github.com/oven-sh/bun/releases/download/bun-v1.4.4/${ARCHIVE}.zip"; \
    unzip -d /tmp /tmp/bun.zip; \
    mv /tmp/${ARCHIVE}/bun /work/opt/bin/bun;

# Install the standalone Vite+ CLI and its toolchain using the official installer.
# https://viteplus.dev/guide/global-cli#installation-variables
ENV VP_HOME=/work/opt/vite-plus
RUN set -eux; \
    curl -o /tmp/vite-plus-install.sh -LsSf https://vite.plus; \
    CI=1 VP_VERSION="1.5.1" VP_SETUP_NODE_VERSION="26.13.0" \
    VP_NODE_MANAGER=no VP_PM_MANAGER=no bash /tmp/vite-plus-install.sh; \
    ln -s /work/opt/vite-plus/bin/vp /work/opt/bin/vp; \
    ln -s /work/opt/vite-plus/bin/vpx /work/opt/bin/vpx; \
    ln -s /work/opt/vite-plus/bin/vpr /work/opt/bin/vpr; \
    rm /tmp/vite-plus-install.sh;



FROM build AS final

ENV NODE_ENV=development
ENV FNM_DIR=/work/opt/fnm
ENV FNM_COREPACK_ENABLED=true

RUN set -eux; \
    echo "eval \"\$(/work/opt/bin/fnm env --use-on-cd --shell bash --fnm-dir=/work/opt/fnm)\"" >> /root/.bashrc;

LABEL org.opencontainers.image.node_version="26.13.0"
LABEL org.opencontainers.image.fnm_version="1.39.0"
LABEL org.opencontainers.image.bun_version="1.4.4"
LABEL org.opencontainers.image.vite_plus_version="1.5.1"
LABEL org.opencontainers.image.corepack_version="0.36.0"


RUN set -eux; \
    rm -rf /var/lib/apt/lists/*

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /work/app

LABEL org.opencontainers.image.watchexec_version="2.8.0"
LABEL org.opencontainers.image.dockerize_version="0.16.0"
LABEL org.opencontainers.image.curl_version="8.23.0-1"
LABEL org.opencontainers.image.actions_runner_version="2.338.2"
LABEL org.opencontainers.image.act_runner_version="5.4.1"
