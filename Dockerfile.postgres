FROM ghcr.io/cloudnative-pg/postgis:17.12-3.7.0-202611201731-standard-trixie AS build

USER root

# Fetch only the packages needed by the Docker Library entrypoint.
RUN set -eux; \
    mkdir -p /tmp/postgres-debs/partial; \
    apt-get update; \
    apt-get install --yes --download-only --no-install-recommends \
        -o Dir::Cache::archives=/tmp/postgres-debs \
        gosu libnss-wrapper xz-utils zstd

FROM ghcr.io/cloudnative-pg/postgis:17.12-3.7.0-202611201731-standard-trixie AS final

USER root

ENV PGDATA=/var/lib/postgresql/data

# Docker Library Postgres 17/trixie at a4513295fc441ad260cf8b605f059ffe4fd4dd6c, with a local initdb default.
COPY --chmod=755 vendor/postgres/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY vendor/postgres/LICENSE /usr/local/share/doc/docker-library-postgres/LICENSE

RUN --mount=type=bind,from=build,source=/tmp/postgres-debs,target=/tmp/postgres-debs \
    set -eux; \
    dpkg -i /tmp/postgres-debs/*.deb; \
    install -d /docker-entrypoint-initdb.d; \
    install -d -o postgres -g postgres -m 3777 /run/postgresql; \
    install -d -o postgres -g postgres -m 1777 "$PGDATA"; \
    sed -i "s/^#listen_addresses = 'localhost'/listen_addresses = '*'/" \
        "$(pg_config --sharedir)/postgresql.conf.sample"

VOLUME /var/lib/postgresql/data
STOPSIGNAL SIGINT
EXPOSE 5432
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["postgres"]

LABEL org.opencontainers.image.cnpg_postgis_version="17.12-3.7.0-202611201731-standard-trixie"
LABEL org.opencontainers.image.postgres_version="17.12"
LABEL org.opencontainers.image.postgis_version="3.7.0"
LABEL org.opencontainers.image.pgvector_version="0.8.7"
