FROM ghcr.io/cloudnative-pg/postgis:${CNPG_POSTGIS_VERSION} AS final

USER root

ENV PGDATA=/var/lib/postgresql/data

# Docker Library Postgres 17/trixie at a4513295fc441ad260cf8b605f059ffe4fd4dd6c, with a local initdb default.
COPY --chmod=755 vendor/postgres/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY vendor/postgres/LICENSE /usr/local/share/doc/docker-library-postgres/LICENSE

RUN --mount=type=bind,from=build,source=/tmp/postgres-debs,target=/tmp/postgres-debs \
    set -eux; \
    dpkg -i /tmp/postgres-debs/*.deb; \
    install -d /docker-entrypoint-initdb.d; \
    install -d -o postgres -g postgres -m 3777 /run/postgresql; \
    install -d -o postgres -g postgres -m 1777 "$$PGDATA"; \
    sed -i "s/^#listen_addresses = 'localhost'/listen_addresses = '*'/" \
        "$$(pg_config --sharedir)/postgresql.conf.sample"

VOLUME /var/lib/postgresql/data
STOPSIGNAL SIGINT
EXPOSE 5432
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["postgres"]

LABEL org.opencontainers.image.cnpg_postgis_version="$CNPG_POSTGIS_VERSION"
LABEL org.opencontainers.image.postgres_version="$POSTGRES_VERSION"
LABEL org.opencontainers.image.postgis_version="$POSTGIS_VERSION"
LABEL org.opencontainers.image.pgvector_version="$PGVECTOR_VERSION"
