FROM ghcr.io/cloudnative-pg/postgis:${CNPG_POSTGIS_VERSION} AS build

USER root

# Fetch only the packages needed by the Docker Library entrypoint.
RUN set -eux; \
    mkdir -p /tmp/postgres-debs/partial; \
    apt-get update; \
    apt-get install --yes --download-only --no-install-recommends \
        -o Dir::Cache::archives=/tmp/postgres-debs \
        gosu libnss-wrapper xz-utils zstd
