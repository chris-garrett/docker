FROM postgis/postgis:${POSTGIS_VERSION} AS build

RUN --mount=type=cache,target=/var/cache/apk,sharing=locked set -x; \
    apk update \
    && apk add \
    git \
    build-base


FROM build AS pgvector

RUN --mount=type=cache,target=/var/cache/apk,sharing=locked set -x; \
    apk add \
    clang21 \
    llvm21-dev

ENV LLVM_CONFIG=/usr/bin/llvm-config-21

RUN set -x; \
    cd /tmp \
    && find / | grep postgresql | grep -v "/tmp" > /tmp/pg_paths_before.txt \
    && git clone --depth 1 --branch v${PGVECTOR_VERSION} https://github.com/pgvector/pgvector.git \
    && cd pgvector \
    && make \
    && make install \
    && find / | grep postgresql | grep -v "/tmp" > /tmp/pg_paths_after.txt

